{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lofa://review",
  "title": "LOFA 审阅补齐接口契约(M4, 对齐真后端 reviewstage store.py / routes.py / reviewstageClient.ts)",
  "$defs": {
    "target": {
      "$comment": "后端 Comment/Annotation 的 target —— 定位字段无 type。image {x,y,w,h} 归一化; markdown {line_start,line_end}; html {selector}; key_question {question_index}。",
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "line_start": { "type": "number" },
        "line_end": { "type": "number" },
        "text_quote": { "type": "string" },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "url": { "type": "string" },
        "selector": { "type": "string" },
        "question_index": { "type": "number" }
      },
      "additionalProperties": true
    },
    "comment": {
      "$comment": "Comment.to_dict() / Annotation.to_dict(): content + author + target(无 text/body/by/anchor)。",
      "type": "object",
      "required": ["content", "author"],
      "properties": {
        "id": { "type": ["string", "number", "null"] },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "created_at": { "type": ["string", "null"] },
        "feedback_status": { "type": "string" },
        "feedback_history": { "type": "array" },
        "kind": { "type": "string" }
      },
      "additionalProperties": true
    },
    "listItem": {
      "type": "object",
      "required": ["id", "kind", "tier", "status"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "tier": { "type": "string" },
        "status": { "enum": ["pending", "accepted", "rejected", "blocked"] },
        "title": { "type": ["string", "null"] },
        "source_plan_id": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "archived": { "type": "boolean" },
        "pushed_to_user": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "listResponse": {
      "$comment": "GET / → {count, items, filter}(routes.py list_materials)。",
      "type": "object",
      "required": ["items"],
      "properties": {
        "count": { "type": "number" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/listItem" } },
        "filter": { "type": "object" }
      },
      "additionalProperties": true
    },
    "stats": {
      "$comment": "GET /_stats → {total, by_status, by_tier, mandatory_unaccepted, pushed_unread}。",
      "type": "object",
      "required": ["mandatory_unaccepted", "pushed_unread"],
      "properties": {
        "total": { "type": "number" },
        "by_status": { "type": "object" },
        "by_tier": { "type": "object" },
        "mandatory_unaccepted": { "type": "number" },
        "pushed_unread": { "type": "number" }
      },
      "additionalProperties": true
    },
    "material": {
      "$comment": "Material.to_dict(): annotations(Annotation[]) 与 comments(Comment[]) 分离, 均用 target 定位。",
      "type": "object",
      "required": ["id", "kind", "tier", "status"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "tier": { "type": "string" },
        "status": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "inline_content": { "type": ["string", "null"] },
        "file_relpath": { "type": ["string", "null"] },
        "source_plan_id": { "type": ["string", "null"] },
        "extra": { "type": "object" },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/comment" } },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } },
        "annotations_allowed": { "type": "boolean" },
        "pushed_to_user": { "type": "boolean" },
        "archived": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "customWebTemplateMaterial": {
      "allOf": [
        { "$ref": "#/$defs/material" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "custom_web_template" },
            "extra": {
              "type": "object",
              "properties": {
                "template": { "type": "string" },
                "live_url": { "type": "string" },
                "description": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "batchVerdictRequest": {
      "type": "object",
      "required": ["ids", "verdict", "by"],
      "properties": {
        "ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verdict": { "enum": ["accepted", "rejected", "blocked", "pending"] },
        "by": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "batchVerdictResponse": {
      "$comment": "POST /batch_verdict → routes.py 真实键。",
      "type": "object",
      "required": ["changed_count", "changed_ids", "not_found", "skipped"],
      "properties": {
        "ok": { "type": "boolean" },
        "changed_count": { "type": "number" },
        "changed_ids": { "type": "array", "items": { "type": "string" } },
        "not_found": { "type": "array", "items": { "type": "string" } },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "error"],
            "properties": { "id": { "type": "string" }, "error": { "type": "string" } }
          }
        }
      },
      "additionalProperties": true
    },
    "batchDeleteRequest": {
      "$comment": "POST /batch_delete BatchDeleteBody: ids + include_pending(选 pending 时语义)。",
      "type": "object",
      "required": ["ids", "by"],
      "properties": {
        "ids": { "type": ["array", "null"], "items": { "type": "string" } },
        "by": { "type": "string" },
        "include_pending": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "batchDeleteResponse": {
      "$comment": "POST /batch_delete → routes.py 真实键(skipped_pending 是计数)。",
      "type": "object",
      "required": ["deleted_count", "deleted_ids", "skipped_pending", "not_found"],
      "properties": {
        "ok": { "type": "boolean" },
        "deleted_count": { "type": "number" },
        "deleted_ids": { "type": "array", "items": { "type": "string" } },
        "skipped_pending": { "type": "number" },
        "not_found": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "commentRequest": {
      "$comment": "POST /{id}/comment CommentBody: content(必填) + author + target(定位, 无 anchor 字段)。",
      "type": "object",
      "required": ["content", "author"],
      "properties": {
        "content": { "type": "string" },
        "author": { "type": "string" },
        "target": { "$ref": "#/$defs/target" }
      },
      "additionalProperties": false
    },
    "streamEvent": {
      "$comment": "WS /stream 帧 = {event_type, material}(routes.py on_store_event)。event_type 为 store.py emit 真集, 无 archived。",
      "type": "object",
      "required": ["event_type"],
      "properties": {
        "event_type": {
          "enum": ["created", "updated", "verdict_changed", "comment_added", "annotation_added", "pushed", "deleted"]
        },
        "material": { "$ref": "#/$defs/material" }
      },
      "additionalProperties": true
    }
  }
}
