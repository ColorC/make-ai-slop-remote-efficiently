{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lofa://notes",
  "title": "LOFA 笔记接口契约 (KB 只读 + authored 可写)",
  "$defs": {
    "kbListItem": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "size": { "type": "number" },
        "mtime": { "type": "number" }
      },
      "additionalProperties": true
    },
    "kbListResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/kbListItem" } },
        "total": { "type": "number" }
      },
      "additionalProperties": true
    },
    "kbSearchItem": {
      "type": "object",
      "required": ["id", "title", "snippet"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "snippet": { "type": "string" }
      },
      "additionalProperties": true
    },
    "kbSearchResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/kbSearchItem" } },
        "total": { "type": "number" }
      },
      "additionalProperties": true
    },
    "kbNoteDetail": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "content": { "type": "string" },
        "mtime": { "type": "number" },
        "size": { "type": "number" }
      },
      "additionalProperties": true
    },
    "authoredNote": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "target": { "type": "object" },
        "uses": { "type": "array", "items": { "type": "string" } },
        "feedback_status": { "type": "string", "enum": ["saved", "delivered", "read", "to_todo", "todo_done"] },
        "feedback_history": { "type": "array" },
        "captures": { "type": "array" },
        "project_id": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "archived": { "type": "boolean" },
        "extra": { "type": "object" }
      },
      "additionalProperties": true
    },
    "authoredListResponse": {
      "type": "object",
      "required": ["count", "items"],
      "properties": {
        "count": { "type": "number" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/authoredNote" } }
      },
      "additionalProperties": true
    },
    "createRequest": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "uses": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "updateRequest": {
      "type": "object",
      "required": ["by"],
      "properties": {
        "by": { "type": "string" },
        "content": { "type": "string" },
        "title": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deleteResponse": {
      "type": "object",
      "required": ["archived", "id"],
      "properties": {
        "archived": { "type": "boolean" },
        "id": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
