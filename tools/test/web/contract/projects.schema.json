{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lofa://projects",
  "title": "LOFA 项目/任务/计划 只读接口契约",
  "$defs": {
    "projectThread": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "status_ok": { "type": "boolean" },
        "updated": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "stale": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "projectItem": {
      "type": "object",
      "required": ["id", "name", "group"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "group": { "type": "string" },
        "pinned": { "type": "boolean" },
        "plan_count": { "type": "number" },
        "last_active": { "type": ["string", "null"] },
        "activity_7d": { "type": "array", "items": { "type": "boolean" } },
        "index_ok": { "type": ["boolean", "null"] },
        "index_stale": { "type": ["boolean", "null"] },
        "stale_reason": { "type": "string" },
        "threads": { "type": "array", "items": { "$ref": "#/$defs/projectThread" } },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "projectsBoard": {
      "type": "object",
      "required": ["projects"],
      "properties": {
        "projects": { "type": "array", "items": { "$ref": "#/$defs/projectItem" } },
        "groups_order": { "type": "array", "items": { "type": "string" } },
        "group_labels": { "type": "object" }
      },
      "additionalProperties": true
    },
    "questItem": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "short": { "type": ["string", "null"] },
        "group": { "type": ["string", "null"] },
        "objective": { "type": "string" },
        "chapter": { "type": "string" },
        "sub_objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "date": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "active_plan_count": { "type": "number" },
        "activity_7d": { "type": "array", "items": { "type": "boolean" } },
        "last_active": { "type": ["string", "null"] },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "questsResponse": {
      "type": "object",
      "required": ["quests"],
      "properties": {
        "quests": { "type": "array", "items": { "$ref": "#/$defs/questItem" } }
      },
      "additionalProperties": true
    },
    "planListItem": {
      "type": "object",
      "required": ["id", "topic"],
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "category": { "type": "string" },
        "title_zh": { "type": ["string", "null"] },
        "archived": { "type": "boolean" },
        "folder_path": { "type": "string" },
        "file_count": { "type": "number" },
        "has_plan_md": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "plansResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/planListItem" } },
        "total": { "type": "number" }
      },
      "additionalProperties": true
    },
    "projectPlanItem": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": ["string", "null"] },
        "title_zh": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "archived": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "projectPlansResponse": {
      "type": "object",
      "required": ["project", "items", "plan_ids"],
      "properties": {
        "project": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/projectPlanItem" } },
        "plan_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "planDetail": {
      "type": "object",
      "required": ["id", "topic", "files"],
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "folder_path": { "type": "string" },
        "archived": { "type": "boolean" },
        "meta": { "type": "object" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "is_md"],
            "properties": {
              "path": { "type": "string" },
              "is_md": { "type": "boolean" },
              "size": { "type": "number" },
              "mtime": { "type": "number" },
              "note_id_if_md": { "type": ["string", "null"] },
              "summary": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
